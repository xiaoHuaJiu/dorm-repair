<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dormrepair.domain.mapper.RepairAreaMapper">
  <resultMap id="BaseResultMap" type="com.dormrepair.domain.entity.RepairArea">
    <id column="id" property="id" jdbcType="BIGINT"/>
    <result column="parent_id" property="parentId" jdbcType="BIGINT"/>
    <result column="area_code" property="areaCode" jdbcType="VARCHAR"/>
    <result column="area_name" property="areaName" jdbcType="VARCHAR"/>
    <result column="area_type" property="areaType" jdbcType="TINYINT"/>
    <result column="sort_no" property="sortNo" jdbcType="INTEGER"/>
    <result column="status" property="status" jdbcType="TINYINT"/>
    <result column="remark" property="remark" jdbcType="VARCHAR"/>
    <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    <result column="deleted" property="deleted" jdbcType="TINYINT"/>
  </resultMap>

  <sql id="Base_Column_List">
    id, parent_id, area_code, area_name, area_type, sort_no, status, remark, create_time, update_time, deleted
  </sql>

  <select id="selectById" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/>
    FROM repair_area
    WHERE id = #{id}
  </select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO repair_area(parent_id,area_code,area_name,area_type,sort_no,status,remark,deleted)
    VALUES(#{parentId},#{areaCode},#{areaName},#{areaType},#{sortNo},#{status},#{remark},#{deleted})
  </insert>
  <update id="update">UPDATE repair_area SET area_name=#{areaName},sort_no=#{sortNo},remark=#{remark} WHERE id=#{id} AND deleted=0</update>
  <update id="updateStatus">UPDATE repair_area SET status=#{status} WHERE id=#{id} AND deleted=0</update>
  <select id="countSiblingName" resultType="int">
    SELECT COUNT(*) FROM repair_area WHERE parent_id=#{parentId} AND area_type=#{areaType} AND area_name=#{areaName} AND deleted=0
    <if test="excludeId != null">AND id != #{excludeId}</if>
  </select>
  <select id="selectAll" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM repair_area WHERE deleted=0 ORDER BY parent_id,sort_no,id
  </select>
  <select id="selectEnabled" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM repair_area WHERE deleted=0 AND status=1 ORDER BY parent_id,sort_no,id
  </select>
  <select id="selectChildren" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM repair_area WHERE parent_id=#{parentId} AND deleted=0
    <if test="enabledOnly">AND status=1</if> ORDER BY sort_no,id
  </select>
</mapper>
