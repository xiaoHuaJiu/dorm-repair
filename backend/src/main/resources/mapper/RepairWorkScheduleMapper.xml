<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dormrepair.domain.mapper.RepairWorkScheduleMapper">
  <resultMap id="BaseResultMap" type="com.dormrepair.domain.entity.RepairWorkSchedule">
    <id column="id" property="id" jdbcType="BIGINT"/>
    <result column="schedule_name" property="scheduleName" jdbcType="VARCHAR"/>
    <result column="start_date" property="startDate" jdbcType="DATE"/>
    <result column="end_date" property="endDate" jdbcType="DATE"/>
    <result column="work_start_time" property="workStartTime" jdbcType="TIME"/>
    <result column="work_end_time" property="workEndTime" jdbcType="TIME"/>
    <result column="status" property="status" jdbcType="TINYINT"/>
    <result column="remark" property="remark" jdbcType="VARCHAR"/>
    <result column="create_by" property="createBy" jdbcType="BIGINT"/>
    <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
  </resultMap>

  <sql id="Base_Column_List">
    id, schedule_name, start_date, end_date, work_start_time, work_end_time, status, remark, create_by, create_time, update_time
  </sql>

  <select id="selectById" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/>
    FROM repair_work_schedule
    WHERE id = #{id}
  </select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO repair_work_schedule(schedule_name,start_date,end_date,work_start_time,work_end_time,status,remark,create_by)
    VALUES(#{scheduleName},#{startDate},#{endDate},#{workStartTime},#{workEndTime},#{status},#{remark},#{createBy})
  </insert>
  <update id="update">UPDATE repair_work_schedule SET schedule_name=#{scheduleName},start_date=#{startDate},end_date=#{endDate},work_start_time=#{workStartTime},work_end_time=#{workEndTime},status=#{status},remark=#{remark} WHERE id=#{id}</update>
  <update id="updateStatus">UPDATE repair_work_schedule SET status=#{status} WHERE id=#{id}</update>
  <select id="countEnabledOverlap" resultType="int">
    SELECT COUNT(*) FROM repair_work_schedule WHERE status=1 AND start_date &lt;= #{endDate} AND end_date &gt;= #{startDate}
    <if test="excludeId != null">AND id != #{excludeId}</if>
  </select>
  <select id="selectPage" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM repair_work_schedule
    <where>
      <if test="scheduleName != null and scheduleName != ''">AND schedule_name LIKE CONCAT('%',#{scheduleName},'%')</if>
      <if test="status != null">AND status=#{status}</if>
      <if test="date != null">AND start_date &lt;= #{date} AND end_date &gt;= #{date}</if>
    </where>
    ORDER BY start_date DESC,id DESC
  </select>
  <select id="selectEnabledBetween" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/> FROM repair_work_schedule
    WHERE status=1 AND start_date &lt;= #{endDate} AND end_date &gt;= #{startDate}
    ORDER BY start_date,id
  </select>
</mapper>
