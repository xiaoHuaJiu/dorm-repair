<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.dormrepair.domain.mapper.SysFileMapper"><resultMap id="BaseResultMap" type="com.dormrepair.domain.entity.SysFile"><id column="id" property="id"/><result column="original_name" property="originalName"/><result column="bucket_name" property="bucketName"/><result column="object_name" property="objectName"/><result column="file_type" property="fileType"/><result column="content_type" property="contentType"/><result column="file_suffix" property="fileSuffix"/><result column="file_size" property="fileSize"/><result column="biz_type" property="bizType"/><result column="status" property="status"/><result column="create_by" property="createBy"/><result column="create_time" property="createTime"/><result column="deleted" property="deleted"/></resultMap><sql id="Base_Column_List">id,original_name,bucket_name,object_name,file_type,content_type,file_suffix,file_size,biz_type,status,create_by,create_time,deleted</sql><select id="selectById" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM sys_file WHERE id = #{id}</select><select id="selectByIdForUpdate" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM sys_file WHERE id=#{id} FOR UPDATE</select><insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO sys_file(original_name,bucket_name,object_name,file_type,content_type,file_suffix,file_size,biz_type,status,create_by,deleted) VALUES(#{originalName},#{bucketName},#{objectName},#{fileType},#{contentType},#{fileSuffix},#{fileSize},#{bizType},#{status},#{createBy},#{deleted})</insert><update id="markDeleted">UPDATE sys_file SET deleted=1 WHERE id=#{id} AND deleted=0</update><select id="selectExpiredCandidateIds" resultType="long">SELECT id FROM sys_file WHERE status=1 AND deleted=0 AND create_time&lt;#{before} ORDER BY id LIMIT #{limit}</select></mapper>
