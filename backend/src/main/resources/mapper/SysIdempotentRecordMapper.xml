<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dormrepair.domain.mapper.SysIdempotentRecordMapper">
  <resultMap id="BaseResultMap" type="com.dormrepair.domain.entity.SysIdempotentRecord">
    <id column="id" property="id"/><result column="biz_no" property="bizNo"/><result column="biz_type" property="bizType"/>
    <result column="user_id" property="userId"/><result column="request_hash" property="requestHash"/><result column="status" property="status"/>
    <result column="result_snapshot" property="resultSnapshot"/><result column="expire_time" property="expireTime"/>
    <result column="create_time" property="createTime"/><result column="update_time" property="updateTime"/>
  </resultMap>
  <sql id="Base_Column_List">id,biz_no,biz_type,user_id,request_hash,status,result_snapshot,expire_time,create_time,update_time</sql>
  <select id="selectById" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM sys_idempotent_record WHERE id = #{id}</select>
  <select id="selectByBusinessKey" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/>
    FROM sys_idempotent_record WHERE biz_type=#{bizType} AND user_id=#{userId} AND biz_no=#{bizNo}
  </select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sys_idempotent_record(biz_no,biz_type,user_id,request_hash,status,expire_time)
    VALUES(#{bizNo},#{bizType},#{userId},#{requestHash},#{status},#{expireTime})
  </insert>
  <update id="markSuccess">UPDATE sys_idempotent_record SET status=1,result_snapshot=#{resultSnapshot} WHERE id=#{id} AND status=0</update>
</mapper>
