<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dormrepair.domain.mapper.RepairReminderRecordMapper">
  <resultMap id="BaseResultMap" type="com.dormrepair.domain.entity.RepairReminderRecord">
    <id column="id" property="id" jdbcType="BIGINT"/>
    <result column="order_id" property="orderId" jdbcType="BIGINT"/>
    <result column="reminder_type" property="reminderType" jdbcType="TINYINT"/>
    <result column="reminder_level" property="reminderLevel" jdbcType="TINYINT"/>
    <result column="deadline_time" property="deadlineTime" jdbcType="TIMESTAMP"/>
    <result column="receiver_id" property="receiverId" jdbcType="BIGINT"/>
    <result column="send_status" property="sendStatus" jdbcType="TINYINT"/>
    <result column="send_time" property="sendTime" jdbcType="TIMESTAMP"/>
    <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
  </resultMap>

  <sql id="Base_Column_List">
    id, order_id, reminder_type, reminder_level, deadline_time, receiver_id, send_status, send_time, create_time
  </sql>

  <select id="selectById" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/>
    FROM repair_reminder_record
    WHERE id = #{id}
  </select>
  <insert id="insertIgnore" useGeneratedKeys="true" keyProperty="id">
    INSERT IGNORE INTO repair_reminder_record(order_id,reminder_type,reminder_level,deadline_time,receiver_id,send_status,send_time)
    VALUES(#{orderId},#{reminderType},#{reminderLevel},#{deadlineTime},#{receiverId},#{sendStatus},#{sendTime})
  </insert>
</mapper>
