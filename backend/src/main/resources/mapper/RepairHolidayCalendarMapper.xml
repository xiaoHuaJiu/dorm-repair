<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dormrepair.domain.mapper.RepairHolidayCalendarMapper">
 <resultMap id="BaseResultMap" type="com.dormrepair.domain.entity.RepairHolidayCalendar">
  <id column="id" property="id"/><result column="holiday_date" property="holidayDate"/><result column="holiday_name" property="holidayName"/>
  <result column="day_type" property="dayType"/><result column="year" property="year"/><result column="create_time" property="createTime"/><result column="update_time" property="updateTime"/>
 </resultMap>
 <sql id="Base_Column_List">id,holiday_date,holiday_name,day_type,year,create_time,update_time</sql>
 <select id="selectById" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM repair_holiday_calendar WHERE id = #{id}</select>
 <select id="selectByDate" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM repair_holiday_calendar WHERE holiday_date=#{date}</select>
 <select id="selectBetween" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM repair_holiday_calendar WHERE holiday_date BETWEEN #{start} AND #{end} ORDER BY holiday_date</select>
</mapper>
