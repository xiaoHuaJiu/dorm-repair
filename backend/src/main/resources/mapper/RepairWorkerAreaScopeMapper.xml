<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dormrepair.domain.mapper.RepairWorkerAreaScopeMapper">
  <resultMap id="BaseResultMap" type="com.dormrepair.domain.entity.RepairWorkerAreaScope">
    <id column="id" property="id" jdbcType="BIGINT"/>
    <result column="worker_id" property="workerId" jdbcType="BIGINT"/>
    <result column="campus_id" property="campusId" jdbcType="BIGINT"/>
    <result column="area_id" property="areaId" jdbcType="BIGINT"/>
    <result column="building_id" property="buildingId" jdbcType="BIGINT"/>
    <result column="status" property="status" jdbcType="TINYINT"/>
    <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
    <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
  </resultMap>

  <sql id="Base_Column_List">
    id, worker_id, campus_id, area_id, building_id, status, create_time, update_time
  </sql>

  <select id="selectById" resultMap="BaseResultMap">
    SELECT <include refid="Base_Column_List"/>
    FROM repair_worker_area_scope
    WHERE id = #{id}
  </select>
  <select id="selectByWorkerId" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM repair_worker_area_scope WHERE worker_id=#{workerId} ORDER BY id</select>
  <select id="selectByWorkerIdForUpdate" resultMap="BaseResultMap">SELECT <include refid="Base_Column_List"/> FROM repair_worker_area_scope WHERE worker_id=#{workerId} FOR UPDATE</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO repair_worker_area_scope(worker_id,campus_id,area_id,building_id,status) VALUES(#{workerId},#{campusId},#{areaId},#{buildingId},#{status})</insert>
  <update id="updateStatus">UPDATE repair_worker_area_scope SET status=#{status} WHERE id=#{id}</update>
</mapper>
